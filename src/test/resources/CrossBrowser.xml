<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="BessolitsynIV_IPR_AT Test" thread-count="2" parallel="none">
    <listeners>
        <listener class-name="listeners.AnnotationTransformer"/>
        <listener class-name="listeners.TestListener"/>
    </listeners>
    <test name="Chrome">
        <classes>
            <class name="tests.ui.HomeTest">
                <methods>
                    <include name="openLoginPageTest" />
                    <include name="checkTabElementsTest" />
                    <include name="checkPopUpWindowTest" />
                    <include name="checkFeaturesTest" />
                    <include name="checkSolutionsTest" />
                    <include name="checkPlansTest" />
                    <include name="checkResourcesTest" />
                    <include name="clickPricingTest" />
                    <include name="checkPlaceholderTest" />
                    <exclude name="checkButtonSignUpTest" />
                    <include name="clickButtonDotsTest" />
                    <exclude name="checkHoverWhiteAndBlueButtonsTest" />
                    <include name="clickWhiteAndBlueButtonsTest" />
                </methods>
            </class>
            <class name="tests.ui.LoginTest">
                <methods>
                    <include name="openLoginPageTest" />
                    <include name="checkEmailEmptyTest" />
                    <include name="checkEmailIncorrectTest" />
                    <include name="checkCheckboxTest" />
                    <include name="checkAuthorizationButtonsTest" />
                    <include name="checkForgotPassTest" />
                    <exclude name="checkAuthorizationPositiveTest" />
                </methods>
            </class>
            <parameter name="browser" value="chrome"/>
        </classes>
    </test>
    <test name="Firefox">
        <classes>
            <parameter name="browser" value="firefox"/>
        </classes>
    </test>
</suite>
